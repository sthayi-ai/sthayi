{
  "name": "sthayi-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sthayi — the you that persists. Sovereign, local-first memory for every AI, over MCP.",
  "engines": {
    "node": "22.x || 24.x"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:safety": "vitest run tests/safety",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "freshtest": "bash scripts/freshtest.sh",
    "gif": "vhs demo.tape"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/tar-stream": "^3.1.3",
    "@types/unist": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "github-slugger": "^2.0.0",
    "jsonc-parser": "^3.3.1",
    "property-information": "^7.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.3.1",
    "srcset": "^5.0.3",
    "tar-stream": "^3.1.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
