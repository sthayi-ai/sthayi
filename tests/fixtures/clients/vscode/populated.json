{
  "inputs": [
    {
      "type": "promptString",
      "id": "other-api-key",
      "description": "Other tool API key",
      "password": true
    }
  ],
  "servers": {
    "other-tool": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "other-tool-mcp"],
      "env": { "OTHER_API_KEY": "${input:other-api-key}" }
    }
  }
}
