{
  // Zed user settings — the syntax is JSON with support for comments.
  "theme": "One Dark", // user's theme choice must survive wiring byte-exact
  "buffer_font_size": 14,
  "context_servers": {
    // an existing context server the user configured by hand
    "other-tool": {
      "command": "npx",
      "args": ["-y", "other-tool-mcp"],
      "env": {}
    }
  },
  "languages": {
    "TypeScript": { "format_on_save": "on" }
  }
}
